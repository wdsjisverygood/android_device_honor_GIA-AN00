	seninf_top@1a004000 {
			compatible = "mediatek,seninf_top";
			reg = <0x00 0x1a004000 0x00 0x1000>;
			clocks = <0x41 0x13 0x41 0x10 0x41 0x11 0x41 0x12 0x68 0x04 0x48 0x9d 0x48 0x9e 0x48 0x9f 0x48 0xa0 0x48 0x8a 0x48 0x8b 0x48 0x8c 0x48 0x8d 0x48 0x8e 0x48 0x27 0x48 0x26 0x48 0x44 0x48 0x25 0x48 0x43 0x48 0x24 0x48 0x1f 0x48 0x03 0x48 0x19>;
			clock-names = "SCP_SYS_CSI", "SCP_SYS_CAM", "ISP_SCP_SYS_RAWA", "ISP_SCP_SYS_RAWB", "CAMSYS_SENINF_CGPDN", "TOP_MUX_SENINF", "TOP_MUX_SENINF1", "TOP_MUX_SENINF2", "TOP_MUX_SENINF3", "TOP_MUX_CAMTG", "TOP_MUX_CAMTG2", "TOP_MUX_CAMTG3", "TOP_MUX_CAMTG4", "TOP_MUX_CAMTG5", "TOP_UNIVP_192M_D32", "TOP_UNIVP_192M_D16", "TOP_F26M_CK_D2", "TOP_UNIVP_192M_D8", "TOP_CLK26M", "TOP_UNIVP_192M_D4", "TOP_UNIVPLL_D6_D8", "TOP_UNIVP_D4_D2", "TOP_MAINP_D5";
		};

	sensor_network_0@13fcf000 {
