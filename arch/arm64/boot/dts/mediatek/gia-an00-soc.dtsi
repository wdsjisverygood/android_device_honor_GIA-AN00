	sys_timer@10017000 {
			compatible = "mediatek,sys_timer";
			reg = <0x00 0x10017000 0x00 0x1000>;
			reg-names = "sys_timer_base";
			interrupts = <0x00 0x115 0x04>;
			clocks = <0x56>;
		};

	tee_sanity {
			compatible = "mediatek,tee_sanity";
			interrupts = <0x00 0x74 0x01>;
		};

	timer: timer {
			compatible = "arm,armv8-timer";
			interrupt-parent = <0x01>;
			interrupts = <0x01 0x0d 0x04 0x01 0x0e 0x04 0x01 0x0b 0x04 0x01 0x0a 0x04>;
			clock-frequency = <0xc65d40>;
			phandle = <0x13a>;
		};

	topckgen: topckgen@10000000 {
			compatible = "mediatek,topckgen";
			reg = <0x00 0x10000000 0x00 0x1000>;
			phandle = <0xf5>;
		};

	topckgen_ao@1001b000 {
			compatible = "mediatek,topckgen_ao";
			reg = <0x00 0x1001b000 0x00 0x1000>;
		};

	topckgen_clk: syscon@10000000 {
			compatible = "mediatek,mt6877-topckgen", "syscon";
			reg = <0x00 0x10000000 0x00 0x1000>;
			#clock-cells = <0x01>;
			phandle = <0x48>;
		};

	topmisc@10011000 {
			compatible = "mediatek,topmisc";
			reg = <0x00 0x10011000 0x00 0x1000>;
		};

	trusted_core {
			compatible = "trusted_core";
			interrupts = <0x00 0x53 0x04>;
		};

	vdec_gcon_clk: syscon@1602f000 {
			compatible = "mediatek,mt6877-vdecsys", "syscon";
			reg = <0x00 0x1602f000 0x00 0x1000>;
			pwr-regmap = <0x41>;
			#clock-cells = <0x01>;
			phandle = <0x67>;
		};

	venc_gcon_clk: syscon@17000000 {
			compatible = "mediatek,mt6877-vencsys", "syscon";
			reg = <0x00 0x17000000 0x00 0x1000>;
			pwr-regmap = <0x41>;
			#clock-cells = <0x01>;
			phandle = <0x7d>;
		};

