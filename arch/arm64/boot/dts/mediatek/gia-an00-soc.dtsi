					vproc_temp {
						channel = <0x07>;
					};
	
					vgpu_temp {
						channel = <0x08>;
					};
	
					accdet {
						channel = <0x09>;
					};
	
					dcxo_volt {
						channel = <0x0a>;
						resistance-ratio = <0x03 0x02>;
					};
	
					tsx_temp {
						channel = <0x0b>;
						avg-num = <0x80>;
					};
	
