				pmic: mt-pmic {
					compatible = "mediatek,mt-pmic";
					interrupts = <0x30 0x04 0x32 0x04 0x31 0x04 0x33 0x04 0x70 0x04 0x71 0x04 0x52 0x04 0x53 0x04>;
