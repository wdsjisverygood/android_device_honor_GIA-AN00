				pmic_auxadc: mt635x-auxadc {
					compatible = "mediatek,mt6359-auxadc";
					#io-channel-cells = <0x01>;
					phandle = <0x10b>;
	
					batadc {
						channel = <0x00>;
						resistance-ratio = <0x07 0x02>;
						avg-num = <0x80>;
