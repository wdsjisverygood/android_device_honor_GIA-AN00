			reg = <0x00 0x10001000 0x00 0x1000 0x00 0x10002000 0x00 0x1000 0x00 0x10022000 0x00 0x1000 0x00 0xc538000 0x00 0x5000 0x00 0xc53a800 0x00 0x1000>;
			reg-names = "infracfg_ao", "infracfg_ao_mem", "infra_ao_bcrm", "mp_cpusys_top", "cpccfg_reg";
