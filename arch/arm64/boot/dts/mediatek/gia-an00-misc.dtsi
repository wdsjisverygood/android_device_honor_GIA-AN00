	pio: pinctrl {
			compatible = "mediatek,mt6877-pinctrl";
			reg_bases = <0x36 0x37 0x38 0x39 0x3a 0x3b 0x3c 0x3d 0x3e>;
			reg_base_eint = <0x3f>;
			pins-are-numbered;
			gpio-controller;
			gpio-ranges = <0x02 0x00 0x00 0xd1>;
			#gpio-cells = <0x02>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
			interrupts = <0x00 0x100 0x04>;
			interrupt-parent = <0x01>;
			phandle = <0x02>;
	
			aud_clk_mosi_off: aud_clk_mosi_off {
				phandle = <0x9c>;
	
				pins_cmd0_dat {
					pinmux = <0x3200>;
					input-enable;
					bias-pull-down;
				};
	
				pins_cmd1_dat {
					pinmux = <0x3300>;
					input-enable;
					bias-pull-down;
				};
			};
	
			aud_clk_mosi_on: aud_clk_mosi_on {
				phandle = <0x9d>;
	
				pins_cmd0_dat {
					pinmux = <0x3201>;
					input-schmitt-enable;
					bias-disable;
				};
	
				pins_cmd1_dat {
					pinmux = <0x3301>;
					input-schmitt-enable;
					bias-disable;
				};
			};
	
			aud_dat_mosi_off: aud_dat_mosi_off {
