			clock-names = "baud", "bus";
			dmas = <0x57 0x00 0x57 0x01>;
			dma-names = "tx", "rx";
			phandle = <0x13c>;
		};

	apuart1: serial@11003000 {
			compatible = "mediatek,mt6577-uart";
