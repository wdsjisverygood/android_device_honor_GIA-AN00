	spi5: spi5@11019000 {
			compatible = "mediatek,mt6765-spi";
			mediatek,pad-select = <0x00>;
			reg = <0x00 0x11019000 0x00 0x100>;
			interrupts = <0x00 0xd0 0x04>;
			clocks = <0x48 0x09 0x48 0x90 0x40 0x2f>;
			clock-names = "parent-clk", "sel-clk", "spi-clk";
			phandle = <0x1a3>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;
	
			fingerprint_sensor@0 {
				compatible = "mediatek,mtk_finger";
				reg = <0x00>;
				spi-max-frequency = "", "I>";
				fingerprint,navigation_adjust1 = <0x00>;
				fingerprint,poweroff_scheme = <0x00>;
				fingerprint,custom_timing_scheme = <0x02>;
				fingerprint,use_tp_irq = <0x01>;
				fingerprint,product_id = <0x3ea>;
				pinctrl-names = "fingerprint_spi_default", "fingerprint_spi_cs_low", "fingerprint_spi_cs_high", "fingerprint_spi_miso_low", "fingerprint_spi_miso_high", "fingerprint_spi_mosi_low", "fingerprint_spi_mosi_high", "fingerprint_spi_mclk_low", "fingerprint_spi_mclk_high", "fingerprint_rst_low", "fingerprint_rst_high", "fingerprint_power_low", "fingerprint_power_high";
				pinctrl-0 = <0x20d>;
				pinctrl-1 = <0x20e>;
				pinctrl-2 = <0x20f>;
				pinctrl-3 = <0x210>;
				pinctrl-4 = <0x211>;
				pinctrl-5 = <0x212>;
				pinctrl-6 = <0x213>;
				pinctrl-7 = <0x214>;
				pinctrl-8 = <0x215>;
				pinctrl-9 = <0x216>;
				pinctrl-10 = <0x217>;
				pinctrl-11 = <0x218>;
				pinctrl-12 = <0x219>;
				fp_vdd-supply = <0x51>;
				status = "okay";
			};
		};

