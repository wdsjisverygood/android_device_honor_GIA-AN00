	udi: udi@10005000 {
			compatible = "mediatek,udi";
			reg = <0x00 0x10005000 0x00 0x1000>;
			udi_offset1 = <0x440>;
			udi_value1 = "@D", "";
			udi_offset2 = <0x450>;
			udi_value2 = <0x44>;
			ecc_debug = <0x00>;
			phandle = <0xf8>;
		};

	vcu: vcu@16000000 {
			compatible = "mediatek-vcu";
			mediatek,vcuid = <0x00>;
			mediatek,vcuname = "vcu";
			reg = <0x00 0x16000000 0x00 0x40000 0x00 0x17020000 0x00 0x10000>;
			iommus = <0x63 0x80>;
			mediatek,mailbox-gce = <0x5e>;
			mediatek,dec_gce_th_num = <0x01>;
			mediatek,enc_gce_th_num = <0x01>;
			mboxes = <0x5e 0x07 0x00 0x01 0x5e 0x0c 0x00 0x01 0x60 0x0c 0x00 0x01>;
			gce-event-names = "venc_eof", "venc_cmdq_pause_done", "venc_mb_done", "venc_sps_done", "venc_pps_done", "venc_128B_cnt_done", "vdec_pic_start", "vdec_decode_done", "vdec_pause", "vdec_dec_error", "vdec_mc_busy_overflow_timeout", "vdec_all_dram_req_done", "vdec_ini_fetch_rdy", "vdec_process_flag", "vdec_search_start_code_done", "vdec_ref_reorder_done", "vdec_wp_tble_done", "vdec_count_sram_clr_done", "vdec_gce_cnt_op_threshold";
			gce-events = <0x5e 0x81 0x5e 0x82 0x5e 0x84 0x5e 0x89 0x5e 0x88 0x5e 0x85 0x5e 0xa0 0x5e 0xa1 0x5e 0xa2 0x5e 0xa3 0x5e 0xa4 0x5e 0xa5 0x5e 0xa6 0x5e 0xa7 0x5e 0xa8 0x5e 0xa9 0x5e 0xaa 0x5e 0xab 0x5e 0xaf>;
			gce-gpr = <0x0a 0x0b>;
			phandle = <0x7c>;
		};

	water_check: water_check {
			compatible = "honor,water_check";
