	reserved@14015000 {
			compatible = "mediatek,reserved";
			reg = <0x00 0x14015000 0x00 0x1000>;
		};

	reserved@1401d000 {
			compatible = "mediatek,reserved";
			reg = <0x00 0x1401d000 0x00 0x1000>;
		};

	reserved@14030000 {
			compatible = "mediatek,reserved";
			reg = <0x00 0x14030000 0x00 0xd0000>;
		};

	rsc@1b003000 {
			compatible = "mediatek,rsc";
			mediatek,larb = <0x79>;
			reg = <0x00 0x1b003000 0x00 0x1000>;
			interrupts = <0x00 0x1b6 0x04>;
			mboxes = <0x5e 0x0d 0x00 0x01>;
			gce-event-names = "rsc_eof";
			gce-events = <0x5e 0xb3>;
			clocks = <0x6b 0x05>;
			clock-names = "RSC_CLK_IPE_RSC";
		};

	shell_back: shell_back@0 {
			compatible = "hn,shell-temp";
			status = "ok";
			phandle = <0x1d7>;
		};

	shell_frame: shell_frame@0 {
			compatible = "hn,shell-temp";
			status = "ok";
			phandle = <0x1d5>;
		};

	shell_front: shell_front@0 {
			compatible = "hn,shell-temp";
			status = "ok";
			phandle = <0x1d6>;
		};

	sle95250: sle95250 {
			compatible = "infineon,sle95250";
			status = "ok";
			phandle = <0x05>;
			pinctrl-names = "default";
			pinctrl-0 = <0x21d>;
			onewire-gpio = <0x02 0x14 0x00>;
			product_id0 = <0x01>;
			product_id2 = <0x03>;
			gpio_sn_mode_val = <0x01>;
			dip_check = <0x00>;
			gpio_swi = <0x14>;
			gpio_id_mode = <0x13>;
			gpio_swi_drv = <0x03>;
		};

	spi0: spi0@1100a000 {
			compatible = "mediatek,mt6765-spi";
			mediatek,pad-select = <0x00>;
			reg = <0x00 0x1100a000 0x00 0x100>;
			interrupts = <0x00 0xcb 0x04>;
			clocks = <0x48 0x09 0x48 0x90 0x40 0x15>;
			clock-names = "parent-clk", "sel-clk", "spi-clk";
			phandle = <0x19e>;
			status = "ok";
			mediatek,kthread-rt = <0x01>;
	
			honor_thp@0 {
				compatible = "honor,thp";
				spi-max-frequency = <0x989680>;
				spi-bus-id = <0x00>;
				spi-mode = <0x00>;
				reg = <0x00>;
				spi_sync_cs_hi_delay_ns = <0xc8>;
				spi_sync_cs_low_delay_ns = <0x0a>;
				irq_gpio = <0x02 0x0e 0x00>;
				rst_gpio = <0x02 0x0f 0x00>;
				cs_gpio = <0x02 0x7b 0x00>;
				boot_reset_hi_delay_ms = <0x01>;
				boot_reset_low_delay_ms = <0x00>;
				boot_reset_after_delay_ms = <0x00>;
				resume_reset_after_delay_ms = <0x0a>;
				suspend_reset_after_delay_ms = <0x00>;
				use_mdelay = <0x01>;
				irq_flag = <0x02>;
				interrupt-parent = <0x02>;
				interrupts = <0x0e 0x08 0x00 0x00>;
				thp-vcc-type = <0x01>;
				thp-vcc-supply = <0x51>;
				thp-vcc-value = <0x325aa0>;
				thp-iovdd-type = <0x02>;
				thp-iovdd-gpio = <0x02 0x6c 0x00>;
				thp-iovdd-value = <0x1b7740>;
				support_pinctrl = <0x01>;
				pinctrl-names = "default", "idle", "state_eint_as_int", "state_rst_output0", "state_rst_output1", "state_cs_output0", "state_cs_output1", "state_spi_status";
				pinctrl-0 = <0x207 0x208>;
				pinctrl-1 = <0x209 0x20a>;
				pinctrl-2 = <0x20b>;
				pinctrl-3 = <0x209>;
				pinctrl-4 = <0x207>;
				pinctrl-5 = <0x20a>;
				pinctrl-6 = <0x208>;
				pinctrl-7 = <0x20c>;
				pt_station_test = <0x01>;
				project_in_tp = <0x01>;
				support_disalbe_vio18_lp = <0x01>;
				self_control_power = <0x01>;
				hide_product_info_en = <0x01>;
				change_spi_driving_force = <0x01>;
				support_gesture_mode = <0x01>;
				use_ap_gesture = <0x01>;
				support_fingerprint_switch = <0x01>;
				aod_display_support = <0x01>;
				use_aod_power_ctrl_notify = <0x01>;
				wait_afe_screen_on_support = <0x01>;
				fast_booting_solution = <0x01>;
				support_control_cs_off = <0x01>;
				support_vendor_ic_type = <0x01>;
				supported_charger = <0x01>;
				need_notify_to_roi_algo = <0x01>;
				use_thp_queue = <0x01>;
				support_b_protocol = <0x00>;
				support_dynamic_resolution = <0x01>;
				res_scale = <0x08>;
				support_pg_event_notify = <0x01>;
				support_vcc_regulator_event_nofity = <0x01>;
	
				thp_input_dev {
					compatible = "honor,thp_input";
					abs_max_x = <0x438>;
					abs_max_y = <0x960>;
				};
	
				nova {
					use_default_configuration = <0x01>;
					spi_sync_cs_hi_delay_ns = <0xc8>;
					spi_sync_cs_low_delay_ns = <0xc8>;
					change_spi_driving_force = <0x01>;
					support_vendor_ic_type = <0x01>;
				};
	
				synaptics_thp {
					support_vendor_ic_type = <0x01>;
					need_enable_irq_wake = <0x01>;
					spi_sync_cs_hi_delay_ns = <0x96>;
					spi_sync_cs_low_delay_ns = <0x96>;
					boot_vcc_on_after_delay_ms = <0x05>;
					boot_reset_hi_delay_ms = <0x32>;
					spi-mode = <0x00>;
					suspend_delayms_early_to_before = <0x96>;
					suspend_delayms_before_to_later = <0x0f>;
					resume_delayms_early_to_later = <0x3c>;
					irq_flag = <0x08>;
					need_huge_memory_in_spi = <0x01>;
					support_get_frame_read_once = <0x01>;
					get_frame_size_max = <0x578>;
					send_one_cmd_for_ap = <0x01>;
					change_spi_driving_force = <0x01>;
					support_deepsleep_mode = <0x01>;
					wait_afe_screen_on_support = <0x01>;
					early_suspend_delay_ms = <0x12c>;
				};
	
				goodix_thp {
					support_vendor_ic_type = <0x04>;
					need_enable_irq_wake = <0x01>;
					spi_sync_cs_hi_delay_ns = <0x64>;
					spi_sync_cs_low_delay_ns = <0x64>;
					boot_reset_hi_delay_ms = <0x01>;
					boot_reset_low_delay_ms = <0x01>;
					boot_reset_after_delay_ms = <0x64>;
					resume_reset_after_delay_ms = <0x0a>;
					spi-mode = <0x00>;
					gesture_mode_double_tap = <0x01>;
					suspend_delayms_early_to_before = <0x96>;
					suspend_delayms_before_to_later = <0x0f>;
					resume_delayms_early_to_later = <0x32>;
					change_spi_driving_force = <0x01>;
					support_deepsleep_mode = <0x01>;
					wait_afe_screen_on_support = <0x00>;
				};
	
				focal {
					use_default_configuration = <0x01>;
					boot_reset_hi_delay_ms = <0x00>;
					boot_reset_low_delay_ms = <0x05>;
					spi_sync_cs_hi_delay_ns = <0xc8>;
					spi_sync_cs_low_delay_ns = <0x3e8>;
					support_vendor_ic_type = <0x01>;
					change_spi_driving_force = <0x01>;
					reset_status_in_suspend_mode = <0x00>;
					lcd_need_get_afe_status = <0x00>;
				};
	
				ssl {
					use_default_configuration = <0x01>;
					boot_reset_low_delay_ms = <0x05>;
					boot_reset_hi_delay_ms = <0x05>;
				};
	
				ili {
					use_default_configuration = <0x01>;
					boot_reset_low_delay_ms = <0x05>;
					boot_reset_hi_delay_ms = <0x05>;
				};
			};
		};

	spi1: spi1@11010000 {
			compatible = "mediatek,mt6765-spi";
			mediatek,pad-select = <0x00>;
			reg = <0x00 0x11010000 0x00 0x100>;
			interrupts = <0x00 0xcc 0x04>;
			clocks = <0x48 0x09 0x48 0x90 0x40 0x28>;
			clock-names = "parent-clk", "sel-clk", "spi-clk";
			phandle = <0x19f>;
		};

	spi2: spi2@11012000 {
			compatible = "mediatek,mt6765-spi";
			mediatek,pad-select = <0x00>;
			reg = <0x00 0x11012000 0x00 0x100>;
