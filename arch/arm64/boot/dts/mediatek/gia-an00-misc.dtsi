	apdma: dma-controller@10220e00 {
			compatible = "mediatek,mt6577-uart-dma";
			reg = <0x00 0x10220e00 0x00 0x80 0x00 0x10220e80 0x00 0x80 0x00 0x10220f00 0x00 0x80 0x00 0x10220f80 0x00 0x80>;
			interrupts = <0x00 0xb6 0x04 0x00 0xb7 0x04 0x00 0xb8 0x04 0x00 0xb9 0x04>;
