/*
 * HONOR GIA-AN00 / MT6877V/ZA 设备树分片
 * 由实机反编译 device.dts 自动还原，节点内容保持原样
 */

/* 146 个顶层节点 */


	adsp_common: adsp_common@10800000 {
			load = <0x01>;
			compatible = "mediatek,adsp_common";
			reg = <0x00 0x1080b000 0x00 0x50 0x00 0x10806000 0x00 0x100 0x00 0x10806100 0x00 0x04 0x00 0x1080610c 0x00 0x04 0x00 0x1080b050 0x00 0x04 0x00 0x10807000 0x00 0x100 0x00 0x10807100 0x00 0x04 0x00 0x1080710c 0x00 0x04 0x00 0x1080b054 0x00 0x04 0x00 0x10808000 0x00 0x100 0x00 0x10808100 0x00 0x04 0x00 0x1080810c 0x00 0x04 0x00 0x1080b058 0x00 0x04 0x00 0x10809000 0x00 0x100 0x00 0x10809100 0x00 0x04 0x00 0x1080910c 0x00 0x04 0x00 0x1080b05c 0x00 0x04>;
			reg-names = "cfg_secure", "mbox0_base", "mbox0_set", "mbox0_clr", "mbox0_init", "mbox1_base", "mbox1_set", "mbox1_clr", "mbox1_init", "mbox2_base", "mbox2_set", "mbox2_clr", "mbox2_init", "mbox3_base", "mbox3_set", "mbox3_clr", "mbox3_init";
			interrupts = <0x00 0x21a 0x04 0x00 0x21b 0x04 0x00 0x21c 0x04 0x00 0x21d 0x04>;
			interrupt-names = "mbox0", "mbox1", "mbox2", "mbox3";
			#mbox-cells = <0x01>;
			clocks = <0x41 0x0f 0x61 0x00 0x48 0xa8 0x48 0x43 0x48 0x30 0x48 0x7c>;
			clock-names = "scp_sys_adsp", "clk_adsp_ck_cg", "clk_top_adsp_sel", "clk_top_clk26m", "clk_top_adsppll", "clk_top_scp_sel";
			adsp-rsv-ipidma-a = <0x200000>;
			adsp-rsv-logger-a = <0x80000>;
			adsp-rsv-dbg-dump-a = <0x80000>;
			adsp-rsv-core-dump-a = <0x400>;
			adsp-rsv-audio = <0x105000>;
			phandle = <0x62>;
		};

	adsp_core0: adsp_core0@10820000 {
			sysram_size = <0x900000>;
			sysram = <0x7a000000>;
			compatible = "mediatek,adsp_core_0";
			reg = <0x00 0x10800000 0x00 0x6000 0x00 0x10840000 0x00 0x9000 0x00 0x10820000 0x00 0x8000>;
			system = <0x00 0x56000000 0x00 0x900000>;
			interrupts = <0x00 0x214 0x04 0x00 0x216 0x04 0x00 0x218 0x04>;
			mboxes = <0x62 0x00 0x62 0x01>;
			phandle = <0x155>;
		};

	adsp_misc: adsp_misc {
			compatible = "honor,adsp_misc";
			status = "ok";
			phandle = <0x1c7>;
		};

	ak8789_hall: ak8789_hall {
			phandle = <0xe3>;
		};

	alsps_mtk: alsps_mtk {
			phandle = <0x1c3>;
		};

	ana_hs: ana_hs {
			phandle = <0x1ca>;
			compatible = "honor,ana_hs";
			status = "ok";
	
			ana_hs_core@0 {
				compatible = "honor,ana_hs_core";
				bus_type = <0x00>;
				gpio_num = <0x02>;
				gpio_type = <0x00>;
				gpios = <0x02 0x9e 0x00 0x02 0x19 0x00>;
				gpio_init_val = <0x00 0x00>;
				plug_in_seq = <0x00 0x01 0x00 0x00>;
				plug_out_seq = <0x00 0x00 0x00 0x00 0x01 0x00 0x00 0x00>;
				mic_gnd_sequence = <0x01 0x00 0x00 0x96>;
				status = "ok";
			};
		};

	antenna_board_match: antenna_board_match {
			phandle = <0x1d1>;
			compatible = "honor,antenna_board_match";
			io-channels = <0x52 0x04>;
			io-channel-names = "antenna_channel";
			antenna_board_match_range = <0x2d0 0x339>;
			status = "ok";
		};

	antenna_boardid_detect: antenna_boardid_detect {
			phandle = <0x1d0>;
			compatible = "honor,antenna_boardid_detect";
			ant_gpio = <0x02 0xb0 0x00 0x02 0xaf 0x00 0x02 0xac 0x00>;
			status = "disable";
		};

	antenna_cable_detect: antenna_cable_detect {
			phandle = <0x1d2>;
			pinctrl-names = "default", "id0";
			compatible = "honor,antenna_cable_detect";
			pinctrl-0 = <0x21a>;
			pinctrl-1 = <0x21b>;
			gpios = <0x02 0x0c 0x00>;
			gpio_count = <0x01>;
			status = "ok";
		};

