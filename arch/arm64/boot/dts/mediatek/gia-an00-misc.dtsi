		};

	ccu@1a101000 {
			compatible = "mediatek,ccu";
			reg = <0x00 0x1a101000 0x00 0x1000>;
			interrupts = <0x00 0x193 0x04>;
			clocks = <0x68 0x09 0x48 0x84 0x41 0x10>;
			clock-names = "CCU_CLK_CAM_CCU", "CCU_CLK_TOP_MUX", "CAM_PWR";
		};

	charge_pump: charge_pump {
			compatible = "honor,charge_pump";
			status = "disabled";
			phandle = <0xd3>;
		};

	clkitg: clkitg {
			compatible = "simple-bus";
			status = "okay";
			phandle = <0xf1>;
	
			bring-up {
				compatible = "mediatek,clk-bring-up";
				clocks = <0x35>;
			};
		};

	clocks {
	
			clk32k: clk32k {
				compatible = "fixed-clock";
				#clock-cells = <0x00>;
				clock-frequency = <0x7d00>;
				phandle = <0xf2>;
			};
	
			clk26m: clk26m {
				compatible = "fixed-clock";
				#clock-cells = <0x00>;
				clock-frequency = <0x18cba80>;
				phandle = <0x35>;
			};
	
			clk13m: clk13m {
				compatible = "fixed-clock";
				#clock-cells = <0x00>;
				clock-frequency = <0xc65d40>;
				phandle = <0x56>;
			};
	
			ulposc: ulposc {
				compatible = "fixed-clock";
				#clock-cells = <0x00>;
				clock-frequency = <0xf7f4900>;
				phandle = <0xf3>;
			};
		};

