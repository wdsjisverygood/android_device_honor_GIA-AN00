	i2c0: i2c0@11e00000 {
			compatible = "mediatek,i2c";
			id = <0x00>;
			reg = <0x00 0x11e00000 0x00 0x1000 0x00 0x10220200 0x00 0x80>;
			interrupts = <0x00 0x90 0x04>;
			clocks = <0x92 0x00 0x40 0x2d>;
			clock-names = "main", "dma";
			clock-div = <0x05>;
			scl-gpio-id = <0x40>;
			sda-gpio-id = <0x41>;
			gpio_start = <0x11e20000>;
			mem_len = <0x200>;
			eh_cfg = <0x30>;
			pu_cfg = <0x80>;
			rsel_cfg = <0xa0>;
			aed = <0x1a>;
			phandle = <0x32>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			clock-frequency = <0x61a80>;
			mediatek,use-open-drain;
	
			sm5450@6F {
				compatible = "sm5450";
				reg = <0x6f>;
				pinctrl-names = "default";
				pinctrl-0 = <0x21f>;
				intr_gpio_num = <0x11>;
				intr_gpio = <0x02 0x11 0x00>;
				ic_role = <0x01>;
				support_unbalanced_current_sc = <0x00>;
				adc_channel_vbat_sys = <0x0e>;
				fcp_support = <0x01>;
				scp_support = <0x01>;
				lvc_ibat_regulator = <0x2fa8>;
				lvc_vbat_regulator = <0x1194>;
				lvc_vout_regulator = <0x11c6>;
				lvc_ibus_regulator = <0x15e0>;
				sc_ibat_regulator = <0x2fa8>;
				sc_vbat_regulator = <0x1194>;
				sc_vout_regulator = <0x11c6>;
				sc_ibus_regulator = <0x15e0>;
				lvc_vusb2vbus_drop_en = <0x01>;
				sc_vusb2vbus_drop_en = <0x01>;
				bat_comp = <0x00>;
				vclamp = <0x00>;
				r_coul_mohm = <0x02>;
				status = "disabled";
			};
	
			bq25970@65 {
				compatible = "bq25970";
				pinctrl-names = "default";
				pinctrl-0 = <0x220>;
				gpio_int = <0x02 0x17 0x00>;
				switching_frequency = <0x2a3>;
				sense_r_config = <0x14>;
				sense_r_actual = <0x0a>;
				reg = <0x65>;
				status = "ok";
			};
	
			fairchild_fsa9685@25 {
				compatible = "honor,fairchild_fsa9685";
				reg = <0x25>;
				pinctrl-names = "default";
				pinctrl-0 = <0x221>;
				fairchild_fsa9685,gpio-intb = <0x02 0x10 0x00>;
				usbid-enable = <0x00>;
				fcp_support = <0x01>;
				scp_support = <0x01>;
				mhl_detect_disable = <0x01>;
				close_bc12 = <0x01>;
				need_other_bc12 = <0x00>;
				ignore_force_ac = <0x01>;
				interrupt-names = "vbus_change", "device_change", "detach", "attach";
				scp;
				dcd;
				dcd_timeout = <0x258>;
				intb_watchdog = <0x3e8>;
				ovp_sel = <0xdd40a0>;
				status = "ok";
			};
		};

	i2c10: i2c10@11280000 {
