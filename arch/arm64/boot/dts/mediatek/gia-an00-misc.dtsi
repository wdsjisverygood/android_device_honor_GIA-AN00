			compatible = "mediatek,cpumssv";
			state = <0x00>;
			phandle = <0x149>;
		};

	cqdma-controller@10212000 {
			compatible = "mediatek,mt6877-cqdma", "mediatek,mt-cqdma-v1";
			reg = <0x00 0x10212000 0x00 0x80 0x00 0x10212100 0x00 0x80 0x00 0x10212200 0x00 0x80 0x00 0x10212300 0x00 0x80>;
			interrupts = <0x00 0xa6 0x04 0x00 0xa7 0x04 0x00 0xa8 0x04 0x00 0xa9 0x04>;
			clocks = <0x40 0x30>;
			clock-names = "cqdma";
			nr_channel = <0x04>;
			dma-channel-mask = <0x3f>;
			dma-channels = <0x04>;
			dma-requests = <0x04>;
			#dma-cells = <0x01>;
		};

	dcm: dcm@10001000 {
