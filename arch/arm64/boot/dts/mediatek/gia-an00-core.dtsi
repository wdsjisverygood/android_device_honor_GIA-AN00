	cpus {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
	
			cpu0: cpu@000 {
				device_type = "cpu";
				compatible = "arm,cortex-a55";
				reg = <0x00>;
				enable-method = "psci";
				clock-frequency = <0x77359400>;
				cpu-idle-states = <0x06 0x07 0x08 0x09>;
				phandle = <0x0c>;
			};
	
			cpu1: cpu@001 {
				device_type = "cpu";
				compatible = "arm,cortex-a55";
				reg = <0x100>;
				enable-method = "psci";
				clock-frequency = <0x77359400>;
				cpu-idle-states = <0x06 0x07 0x08 0x09>;
				phandle = <0x0d>;
