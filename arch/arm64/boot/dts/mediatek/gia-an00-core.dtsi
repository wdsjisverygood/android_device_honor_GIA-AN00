	rootparam: rootparam {
			phandle = <0xe0>;
			mtk,boardid = <0x00 0x00 0x00 0x00>;
			mtk,board_name = "GIA_AN00_VG";
			mtk,product_name = "GIA-AN00";
			hardware_version = "HN1GIAM";
		};

	subpmic_pmu_eint: subpmic_pmu_eint {
			phandle = <0xf7>;
			interrupt-parent = <0x02>;
			interrupts = <0x04 0x02>;
			status = "okay";
		};

	trusty {
			compatible = "android,trusty-smc-v1";
			ranges;
			#address-cells = <0x02>;
			#size-cells = <0x02>;
			tee-id = <0x00>;
