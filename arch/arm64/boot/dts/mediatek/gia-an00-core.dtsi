				compatible = "arm,cortex-a55";
				reg = <0x400>;
				enable-method = "psci";
				clock-frequency = <0x77359400>;
				cpu-idle-states = <0x06 0x07 0x08 0x09>;
				phandle = <0x10>;
			};
	
			cpu5: cpu@005 {
				device_type = "cpu";
				compatible = "arm,cortex-a55";
				reg = <0x500>;
				enable-method = "psci";
				clock-frequency = <0x77359400>;
				cpu-idle-states = <0x06 0x07 0x08 0x09>;
				phandle = <0x11>;
			};
	
			cpu6: cpu@100 {
				device_type = "cpu";
				compatible = "arm,cortex-a76";
				reg = <0x600>;
				enable-method = "psci";
				clock-frequency = <0x77359400>;
				cpu-idle-states = <0x0a 0x0b 0x08 0x09>;
				phandle = <0x12>;
			};
	
			cpu7: cpu@101 {
				device_type = "cpu";
				compatible = "arm,cortex-a76";
				reg = <0x700>;
				enable-method = "psci";
				clock-frequency = <0x77359400>;
				cpu-idle-states = <0x0a 0x0b 0x08 0x09>;
				phandle = <0x13>;
			};
	
			cpu-map {
	
				cluster0 {
	
					core0 {
						cpu = <0x0c>;
					};
	
					core1 {
						cpu = <0x0d>;
					};
	
					core2 {
						cpu = <0x0e>;
					};
	
					core3 {
						cpu = <0x0f>;
					};
	
					core4 {
						cpu = <0x10>;
					};
	
					core5 {
						cpu = <0x11>;
					};
	
					doe_dvfs_cl0: doe {
						phandle = <0xe5>;
					};
				};
	
				cluster1 {
	
					core0 {
						cpu = <0x12>;
					};
	
					core1 {
						cpu = <0x13>;
					};
	
					doe_dvfs_cl1: doe {
						phandle = <0xe6>;
					};
				};
			};
	
			idle-states {
				entry-method = "arm,psci";
	
				cpuoff_l: cpuoff_l {
					compatible = "mediatek,idle-state";
					arm,psci-suspend-param = <0x10001>;
					local-timer-stop;
					entry-latency-us = <0x32>;
					exit-latency-us = <0x64>;
					min-residency-us = <0x640>;
					phandle = <0x06>;
				};
	
				cpuoff_b: cpuoff_b {
					compatible = "mediatek,idle-state";
					arm,psci-suspend-param = <0x10001>;
					local-timer-stop;
					entry-latency-us = <0x32>;
					exit-latency-us = <0x64>;
					min-residency-us = <0x578>;
					phandle = <0x0a>;
				};
	
				clusteroff_l: clusteroff_l {
					compatible = "mediatek,idle-state";
					arm,psci-suspend-param = <0x1010001>;
					local-timer-stop;
					entry-latency-us = <0x64>;
					exit-latency-us = <0xfa>;
					min-residency-us = <0x834>;
					phandle = <0x07>;
				};
	
				clusteroff_b: clusteroff_b {
					compatible = "mediatek,idle-state";
					arm,psci-suspend-param = <0x1010001>;
					local-timer-stop;
					entry-latency-us = <0x64>;
					exit-latency-us = <0xfa>;
					min-residency-us = <0x76c>;
					phandle = <0x0b>;
				};
	
				mcusysoff: mcusysoff {
					compatible = "mediatek,idle-state";
					arm,psci-suspend-param = <0x1010002>;
					local-timer-stop;
					entry-latency-us = <0x12c>;
					exit-latency-us = <0x4b0>;
					min-residency-us = <0xa28>;
					phandle = <0x08>;
				};
	
				s2idle: s2idle {
					compatible = "mediatek,idle-state";
					arm,psci-suspend-param = <0x1010100>;
					local-timer-stop;
					entry-latency-us = <0x1f4>;
					exit-latency-us = <0x578>;
					min-residency-us = <0xffffffff>;
					phandle = <0x09>;
				};
			};
		};

	debug-kinfo {
			memory-region = <0x4d020000>;
