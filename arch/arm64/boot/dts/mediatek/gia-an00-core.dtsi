		};

	mt6360_pmu: mt6360_pmu_dts {
			status = "ok";
			mt6360,intr_gpio_num = <0x04>;
			mt6360,intr_gpio = <0x02 0x04 0x00>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
			phandle = <0x03>;
			disable_lpsd = <0x01>;
	
			adc: adc {
				compatible = "mediatek,mt6360_pmu_adc";
				interrupt-parent = <0x03>;
				interrupts = <0x29 0x00 0x2b 0x00 0x2c 0x00>;
				interrupt-names = "bat_ovp_adc_evt", "adc_wakeup_evt", "adc_donei";
				#io-channel-cells = <0x01>;
				phandle = <0x04>;
			};
	
			chg {
				compatible = "mediatek,mt6360_pmu_chg";
				interrupt-parent = <0x03>;
				interrupts = <0x04 0x00 0x06 0x00 0x07 0x00 0x09 0x00 0x0c 0x00 0x0d 0x00 0x0e 0x00 0x0f 0x00 0x1b 0x00 0x1d 0x00 0x20 0x00 0x23 0x00 0x28 0x00 0x30 0x00 0x3c 0x00>;
				interrupt-names = "chg_treg_evt", "chg_mivr_evt", "pwr_rdy_evt", "chg_batsysuv_evt", "chg_vsysuv_evt", "chg_vsysov_evt", "chg_vbatov_evt", "chg_vbusov_evt", "chg_tmri", "chg_adpbadi", "chg_aiccmeasl", "wdtmri", "pumpx_donei", "attachi", "chrdet_ext_evt";
				io-channels = <0x04 0x00 0x04 0x01 0x04 0x03 0x04 0x04 0x04 0x05 0x04 0x06 0x04 0x08 0x04 0x0a>;
				io-channel-names = "USBID", "VBUSDIV5", "VSYS", "VBAT", "IBUS", "IBAT", "TEMP_JC", "TS";
				chg_name = "primary_chg";
				ichg = <0x1e8480>;
				aicr = <0x7a120>;
				mivr = <0x432380>;
				cv = <0x426030>;
				ieoc = <0x249f0>;
				safety_timer = <0x14>;
				ircmp_resistor = <0x00>;
				ircmp_vclamp = <0x7d00>;
				en_te = <0x01>;
				en_wdt = <0x01>;
				en_otg_wdt = <0x01>;
				aicc_once = <0x01>;
				post_aicc = <0x01>;
				batoc_notify = <0x00>;
			};
	
			mt6360_fled: fled {
				compatible = "mediatek,mt6360_pmu_fled";
				interrupt-parent = <0x03>;
				interrupts = <0x0b 0x00 0x4a 0x00 0x4b 0x00 0x4e 0x00 0x4f 0x00>;
				interrupt-names = "fled_chg_vinovp_evt", "fled_tx_evt", "fled_lvf_evt", "fled2_short_evt", "fled1_short_evt";
				fled_vmid_track = <0x00>;
				fled_strb_tout = <0x4e0>;
				fled1_tor_cur = <0x927c>;
				fled1_strb_cur = <0xb71b0>;
				fled2_tor_cur = <0x927c>;
				fled2_strb_cur = "", "\f5";
				phandle = <0xb5>;
			};
	
			rgbled {
				compatible = "mediatek,mt6360_pmu_rgbled";
				mt,led_name = "mt6360_pmu_led1", "mt6360_pmu_led2", "mt6360_pmu_led3", "mt6360_pmu_led4";
				mt,led_default_trigger = "cc_mode", "cc_mode", "cc_mode", "none";
			};
	
			core {
				compatible = "mediatek,mt6360_pmu_core";
				interrupt-parent = <0x03>;
				interrupts = <0x41 0x00 0x42 0x00 0x43 0x00 0x44 0x00 0x45 0x00 0x46 0x00 0x47 0x00>;
				interrupt-names = "ap_wdtrst_evt", "en_evt", "qonb_rst_evt", "mrstb_evt", "otp_evt", "vddaov_evt", "sysuv_evt";
				mren = <0x01>;
				apwdtrst_en = <0x01>;
				cc_open_sel = <0x03>;
				i2c_cc_open_tsel = <0x01>;
				ldo5_otp_en = <0x00>;
			};
		};

	mtk_lpm: mtk_lpm {
			compatible = "mediatek,mtk-lpm";
			#address-cells = <0x02>;
			#size-cells = <0x02>;
			ranges;
			suspend-method = "s2idle";
			cpupm-method = "mcu";
			irq-remain = <0x14 0x15 0x16 0x17 0x18 0x19 0x1a 0x1b 0x1c 0x1d 0x1e 0x1f 0x20 0x21 0x22>;
			resource-ctrl = <0x23 0x24 0x25 0x26 0x27>;
			constraints = <0x28 0x29 0x2a>;
			phandle = <0xeb>;
	
			cpupm_sysram: cpupm-sysram@0011b000 {
				compatible = "mediatek,cpupm-sysram";
				reg = <0x00 0x11b000 0x00 0x500>;
				phandle = <0xec>;
			};
	
			lpm_sysram: lpm_sysram@0011b500 {
				compatible = "mediatek,lpm-sysram";
				reg = <0x00 0x11b500 0x00 0x300>;
				phandle = <0xed>;
			};
	
			irq-remain-list {
	
				edge_keypad: edge_keypad {
					target = <0x2b>;
					value = <0x01 0x00 0x00 0x04>;
					phandle = <0x14>;
				};
	
				edge_mdwdt: edge_mdwdt {
					target = <0x2c>;
					value = <0x01 0x00 0x80000000 0x2000000>;
					phandle = <0x15>;
				};
	
				level_vpu_core0: level_vpu_core0 {
					target = <0x2d>;
					value = <0x00 0x00 0x00 0x00>;
					phandle = <0x16>;
				};
	
				level_vpu_core1: level_vpu_core1 {
					target = <0x2e>;
					value = <0x00 0x00 0x00 0x00>;
					phandle = <0x17>;
				};
	
				level_mtk_mdla0: level_mtk_mdla0 {
					target = <0x2f>;
					value = <0x00 0x00 0x00 0x00>;
					phandle = <0x18>;
				};
	
				level_edma0: level_edma0 {
					target = <0x30>;
					value = <0x00 0x00 0x00 0x00>;
					phandle = <0x19>;
				};
	
				level_mali0: level_mali0 {
					target = <0x31>;
					value = <0x00 0x00 0x00 0x00>;
					phandle = <0x1a>;
				};
	
				level_mali1: level_mali1 {
					target = <0x31>;
					value = <0x00 0x01 0x00 0x00>;
					phandle = <0x1b>;
				};
	
				level_mali2: level_mali2 {
					target = <0x31>;
					value = <0x00 0x02 0x00 0x00>;
					phandle = <0x1c>;
				};
	
				level_mali3: level_mali3 {
					target = <0x31>;
					value = <0x00 0x03 0x00 0x00>;
					phandle = <0x1d>;
				};
	
				level_mali4: level_mali4 {
					target = <0x31>;
					value = <0x00 0x04 0x00 0x00>;
					phandle = <0x1e>;
				};
	
				level_i2c0: level_i2c0 {
					target = <0x32>;
					value = <0x00 0x00 0x00 0x00>;
					phandle = <0x1f>;
				};
	
				level_btif_tx: level_btif_tx {
					target = <0x33>;
					value = <0x00 0x01 0x00 0x00>;
					phandle = <0x20>;
				};
	
				level_btif_rx: level_btif_rx {
					target = <0x33>;
					value = <0x00 0x02 0x00 0x00>;
					phandle = <0x21>;
				};
	
				level_bt: level_bt {
					target = <0x34>;
					value = <0x00 0x00 0x00 0x00>;
					phandle = <0x22>;
				};
			};
	
			resource-ctrl-list {
	
				bus26m: bus26m {
					id = <0x00>;
					value = <0x00>;
					phandle = <0x23>;
				};
	
				infra: infra {
					id = <0x01>;
					value = <0x00>;
					phandle = <0x24>;
				};
	
				syspll: syspll {
					id = <0x02>;
					value = <0x00>;
					phandle = <0x25>;
				};
	
				dram_s0: dram_s0 {
					id = <0x03>;
					value = <0x00>;
					phandle = <0x26>;
				};
	
				dram_s1: dram_s1 {
					id = <0x04>;
					value = <0x00>;
					phandle = <0x27>;
				};
			};
	
			constraint-list {
	
				rc_bus26m: rc_bus26m {
					id = <0x00>;
					value = <0x01>;
					phandle = <0x28>;
				};
	
				rc_syspll: rc_syspll {
					id = <0x01>;
					value = <0x01>;
					phandle = <0x29>;
				};
	
				rc_dram: rc_dram {
					id = <0x02>;
					value = <0x01>;
					phandle = <0x2a>;
				};
			};
		};

	pmu {
			compatible = "arm,armv8-pmuv3";
			interrupt-parent = <0x01>;
			interrupts = <0x01 0x07 0x04>;
		};

	psci {
			compatible = "arm,psci-1.0";
			method = "smc";
		};

	reserved_memory: reserved-memory {
