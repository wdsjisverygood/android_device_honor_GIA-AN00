#
# BoardConfig.mk — Honor 60 SE (GIA-AN00 / HNGIA-M / MT6877V/ZA)
# TWRP 12.1 device tree
#
# 内核参数全部来自实机 boot_b.img 头解析：
#   kernel_addr=0x40080000 ramdisk_addr=0x51100000 tags_addr=0x47C80000
#   page_size=2048 header_version=2 dtb_size=181895
#

DEVICE_PATH := device/honor/gia

# ===== 架构 =====
TARGET_ARCH := arm64
TARGET_ARCH_VARIANT := armv8-2a
TARGET_CPU_ABI := arm64-v8a
TARGET_CPU_ABI2 :=
TARGET_CPU_VARIANT := generic
TARGET_CPU_VARIANT_RUNTIME := cortex-a76

TARGET_2ND_ARCH := arm
TARGET_2ND_ARCH_VARIANT := armv8-2a
TARGET_2ND_CPU_ABI := armeabi-v7a
TARGET_2ND_CPU_ABI2 := armeabi
TARGET_2ND_CPU_VARIANT := generic
TARGET_2ND_CPU_VARIANT_RUNTIME := cortex-a55

TARGET_BOARD_PLATFORM := mt6877
TARGET_BOOTLOADER_BOARD_NAME := mt6877
TARGET_USES_64_BIT_BINDER := true
TARGET_SUPPORTS_64_BIT_APPS := true

# ===== 预编译内核 =====
TARGET_PREBUILT_KERNEL := $(DEVICE_PATH)/prebuilt/kernel
TARGET_PREBUILT_DTB := $(DEVICE_PATH)/prebuilt/dtb
BOARD_KERNEL_IMAGE_NAME := kernel

BOARD_KERNEL_CMDLINE := bootopt=64S3,32N2,64N2 buildvariant=user
BOARD_KERNEL_BASE := 0x40000000
BOARD_KERNEL_OFFSET := 0x00080000
BOARD_RAMDISK_OFFSET := 0x11100000
BOARD_TAGS_OFFSET := 0x07C80000
BOARD_KERNEL_PAGESIZE := 2048

BOARD_MKBOOTIMG_ARGS := --header_version 2
BOARD_MKBOOTIMG_ARGS += --dtb $(TARGET_PREBUILT_DTB)
BOARD_MKBOOTIMG_ARGS += --kernel_offset $(BOARD_KERNEL_OFFSET)
BOARD_MKBOOTIMG_ARGS += --ramdisk_offset $(BOARD_RAMDISK_OFFSET)
BOARD_MKBOOTIMG_ARGS += --tags_offset $(BOARD_TAGS_OFFSET)

# ===== 分区：A/B + 动态分区 =====
# AB_OTA_UPDATER 由运行时 slot 检测，构建 recovery 不需要
BOARD_USES_METADATA_PARTITION := true
BOARD_SUPER_PARTITION_SIZE := 9227468800
BOARD_SUPER_PARTITION_GROUPS := honor_dynamic_partitions
BOARD_HONOR_DYNAMIC_PARTITIONS_SIZE := 9223270400
BOARD_HONOR_DYNAMIC_PARTITIONS_PARTITION_LIST := system system_ext vendor product_h odm

# ===== Recovery =====
TARGET_RECOVERY_FSTAB := $(DEVICE_PATH)/recovery.fstab
TARGET_RECOVERY_PIXEL_FORMAT := "ABGR_8888"
TARGET_RECOVERY_DEVICE_DIRS := $(DEVICE_PATH)
BOARD_USES_RECOVERY_AS_BOOT := false

# 分区大小（缺了这两个，AOSP 12 不会生成 boot/recovery 镜像目标）
BOARD_BOOTIMAGE_PARTITION_SIZE := 31457280
BOARD_RECOVERYIMAGE_PARTITION_SIZE := 47185920

# ===== 文件系统 =====
TARGET_USERIMAGES_USE_EXT4 := true
TARGET_USERIMAGES_USE_F2FS := true
BOARD_USERDATAIMAGE_FILE_SYSTEM_TYPE := f2fs

# ===== TWRP 功能 =====
TW_THEME := portrait_hdpi
TW_SCREEN_BLANK_ON_BOOT := true
TW_EXTRA_LANGUAGES := true
TW_DEFAULT_LANGUAGE := zh_CN
TW_USE_TOOLBOX := true
TW_INCLUDE_REPACKTOOLS := true
TW_INCLUDE_CRYPTO := true
TW_INCLUDE_FBE_METADATA_DECRYPT := true
TW_INCLUDE_NTFS_3G := true
TW_INCLUDE_FUSE_EXFAT := true
TW_USE_SERIALNO_PROPERTY_FOR_DEVICE_ID := true
TW_DEVICE_VERSION := GIA-AN00
TW_MAX_BRIGHTNESS := 2047
TW_DEFAULT_BRIGHTNESS := 1024
TW_BRIGHTNESS_PATH := /sys/class/leds/lcd-backlight/brightness
TW_INPUT_BLACKLIST := "hbtp_vm"
TW_METADATA_DEVICE := /dev/block/by-name/metadata
TW_EXCLUDE_DEFAULT_USB_INIT := true

# ===== 杂项 =====
TARGET_SYSTEM_PROP := $(DEVICE_PATH)/system.prop
TARGET_OTA_ASSERT_DEVICE := gia,GIA-AN00,HNGIA-M,GIA_AN00_VG
TARGET_NO_BOOTLOADER := true
TARGET_NO_RADIOIMAGE := true
ALLOW_MISSING_DEPENDENCIES := true

# 避免 /vendor 被做成符号链接（TWRP prebuilt 会创建真实 vendor 目录）
TARGET_COPY_OUT_VENDOR := vendor
TARGET_COPY_OUT_ODM := odm
TARGET_COPY_OUT_PRODUCT := product
